<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.university.marketplace.controller.MainController">
    <top>
        <VBox spacing="10" styleClass="panel" BorderPane.alignment="CENTER">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
            <Label text="Products Management" styleClass="h2"/>
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Search by SKU or name" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="categoryFilterBox" promptText="Filter category" prefWidth="220"/>
                <CheckBox fx:id="showArchivedCheck" text="Show inactive products"/>
                <Button text="Search" onAction="#onSearch" styleClass="btn-primary"/>
                <Button text="Reset" onAction="#onResetFilters"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.62">
            <AnchorPane>
                <children>
                    <TableView fx:id="productsTable" AnchorPane.topAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0">
                        <columns>
                            <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="skuCol" text="SKU" prefWidth="140"/>
                            <TableColumn fx:id="nameCol" text="Name" prefWidth="200"/>
                            <TableColumn fx:id="categoryCol" text="Categories" prefWidth="200"/>
                            <TableColumn fx:id="priceCol" text="Price" prefWidth="100"/>
                            <TableColumn fx:id="stockCol" text="Stock" prefWidth="80"/>
                            <TableColumn fx:id="statusCol" text="Availability" prefWidth="120"/>
                            <TableColumn fx:id="activeCol" text="State" prefWidth="90"/>
                        </columns>
                    </TableView>
                </children>
            </AnchorPane>

            <VBox spacing="10" styleClass="panel">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="Product Details" styleClass="h3"/>
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="30"/>
                        <ColumnConstraints percentWidth="70"/>
                    </columnConstraints>
                    <Label text="SKU:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="skuField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Price:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="priceField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Stock:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="stockField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Categories:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <ListView fx:id="categoriesList" GridPane.rowIndex="4" GridPane.columnIndex="1" prefHeight="120"/>
                    <Label text="Description:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextArea fx:id="descriptionArea" GridPane.rowIndex="5" GridPane.columnIndex="1" prefHeight="90" wrapText="true"/>
                </GridPane>

                <VBox spacing="8">
                    <Label text="Product image"/>
                    <ImageView fx:id="imagePreview" fitHeight="160" fitWidth="240" preserveRatio="true"/>
                    <HBox spacing="8">
                        <Button text="Upload image" onAction="#onUploadImage"/>
                        <Button text="Remove image" onAction="#onRemoveImage"/>
                    </HBox>
                </VBox>

                <Label fx:id="messageLabel" wrapText="true" styleClass="text-danger"/>

                <HBox spacing="8">
                    <Button text="New" onAction="#onNew"/>
                    <Button text="Save" onAction="#onSave" styleClass="btn-success"/>
                    <Button text="Delete" onAction="#onDelete" styleClass="btn-danger"/>
                </HBox>
                <HBox spacing="8">
                    <Button text="Archive" onAction="#onArchive"/>
                    <Button text="Reactivate" onAction="#onReactivate"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
